{
  "manifest_version": 2,
  "name": "__MSG_extensionName__",
  "short_name": "CTRL",
  "version": "1.1.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "ctrl-extension@example.com",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "debugger",
    "notifications",
    "alarms",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://api.z.ai/*",
    "https://api.meta.ai/*",
    "https://api.mistral.ai/*",
    "https://api.deepseek.com/*",
    "https://api.minimax.io/*",
    "https://generativelanguage.googleapis.com/*",
    "https://dashscope.aliyuncs.com/*",
    "https://openrouter.ai/*",
    "https://api.groq.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "scripts": [
      "platform/browser-api.js",
      "background/firefox-bootstrap.js"
    ],
    "persistent": false
  },
  "browser_action": {
    "default_title": "Open CTRL",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "sidebar_action": {
    "default_title": "CTRL",
    "default_panel": "sidepanel/sidepanel.html",
    "open_at_install": false
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    "PRIVACY-POLICY.md"
  ],
  "commands": {
    "open-sidepanel": {
      "suggested_key": {
        "default": "Alt+Shift+A",
        "mac": "Alt+Shift+A"
      },
      "description": "__MSG_openSidepanelCommand__"
    },
    "toggle-browser-agent": {
      "suggested_key": {
        "default": "Alt+Shift+B",
        "mac": "Alt+Shift+B"
      },
      "description": "__MSG_toggleBrowserAgentCommand__"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["platform/browser-api.js", "content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_end"
    }
  ],
  "content_security_policy": "script-src 'self'; object-src 'self'"
}
