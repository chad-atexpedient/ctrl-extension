{
  "name": "ctrl-extension",
  "version": "1.1.1",
  "description": "CTRL Extension - In-browser AI agent with context awareness and native tool execution",
  "type": "module",
  "scripts": {
    "test": "node --test tests/unit/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:suite": "node test-suite.js",
    "test:integration": "node integration-tests.js",
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed",
    "test:ui:debug": "playwright test --debug",
    "test:all": "npm run test:unit && npm run test:suite && npm run test:integration",
    "lint": "node scripts/lint.js",
    "package": "npm run package:chrome",
    "package:chrome": "node scripts/package.js --target=chrome",
    "package:firefox": "node scripts/package.js --target=firefox",
    "package:safari": "node scripts/package.js --target=safari",
    "package:all": "npm run package:chrome && npm run package:firefox && npm run package:safari",
    "safari:convert": "node scripts/package-safari.js",
    "generate:key": "node scripts/generate-extension-key.js",
    "capture:store-screenshots": "node scripts/capture-store-screenshots.js",
    "validate:distribution": "node scripts/validate-distribution.js",
    "verify": "npm run lint && npm run validate:distribution && npm test"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
